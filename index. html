<script>

function calculateScore(){

    let score = 0;

    for(let i=1;i<=10;i++){

        let answer = document.querySelector(
            'input[name="q'+i+'"]:checked'
        );

        if(answer){
            score += Number(answer.value);
        }
    }

    document.getElementById("result").style.display="block";

    document.getElementById("score").innerHTML =
        score + "/10";

    let message="";

    if(score===10){
        message="😍 Perfect! You know Usman extremely well!";
    }
    else if(score>=8){
        message="💚 Amazing! You really know Usman!";
    }
    else if(score>=6){
        message="😊 Good! You know Usman pretty well!";
    }
    else if(score>=4){
        message="🙂 Not bad! But you need to know Usman better!";
    }
    else{
        message="😂 Looks like you need to spend more time with Usman!";
    }

    document.getElementById("message").innerHTML=message;

    window.scrollTo({
        top:document.body.scrollHeight,
        behavior:"smooth"
    });
}

</script>

